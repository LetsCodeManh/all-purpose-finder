.DS_Store
.claude/settings.local.json
.codex/
.cursor/
CLAUDE.local.md
backlog.md

# sessions hold personal data (your hunt, a client's tenders), and sessions/tools/
# holds the scripts. Local only until you say otherwise.
sessions/*
__pycache__/
*.pyc

# _template is the shape of a session, not a session. Keep it tracked.
!sessions/_template/

# example-* folders are invented data, not somebody's hunt. A fresh clone can
# audit every built-in shape. Keep these exact fixtures tracked.
!sessions/example-jobs/
!sessions/example-tenders/
!sessions/example-prices/
!sessions/example-company-research/
