.claude/settings.local.json
.codex/
.cursor/
CLAUDE.local.md
backlog.md

# sessions hold personal data (your hunt, a client's tenders), and sessions/tools/
# holds the scripts. Local only until you say otherwise.
sessions/*
__pycache__/
*.pyc

# _template is the shape of a session, not a session. Keep it tracked.
!sessions/_template/

# example-jobs is invented data, not somebody's hunt. It is the one session a
# fresh clone can audit and open in the UI. Keep it tracked.
!sessions/example-jobs/
